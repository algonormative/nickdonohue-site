---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Hatch from '../components/Hatch.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import domains from '../data/domains.json';
import agent from '../assets/breach/cathedral/agent-3.webp';
import tower from '../assets/breach/cathedral/tower-211.webp';
import c033 from '../assets/breach/cathedral/cathedral-c033.webp';
import c001 from '../assets/breach/cathedral/cathedral-c001.webp';

// The promoted art set: newest plotter work, shown above the plates.
const promoSheets = [
	{ src: agent, href: '/breach/plenipotentiary', label: 'Plenipotentiary', alt: 'Plenipotentiary: a pinstripe-suited figure with a helix head and a censor bar over its eyes, on a slab throne.' },
	{ src: tower, href: '/breach#cathedral', label: 'Tower', alt: 'Breach Cathedral, Tower: a full-height stack of cantilevered slabs with a helix wound through it.' },
	{ src: c033, href: '/breach#cathedral', label: 'c033', alt: 'Breach Cathedral c033: slab architecture with a ribbed helix membrane looping through it.' },
	{ src: c001, href: '/breach#cathedral', label: 'c001', alt: 'Breach Cathedral c001: slab architecture with a ribbed helix membrane looping through it.' },
];

const published = ({ data }: { data: { draft: boolean } }) =>
	import.meta.env.PROD ? !data.draft : true;

const blog = await getCollection('blog', published);
const molt = await getCollection('molt', published);

const recent = [
	...blog.map((p) => ({ kind: 'Blog', href: `/blog/${p.id}/`, data: p.data })),
	...molt.map((p) => ({ kind: 'Molt', href: `/molt/${p.id}/`, data: p.data })),
]
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const plateBlurbs: Record<string, string> = {
	sound: 'PERIGEE is a five-track EP conducted by a coding agent on an Analog Rytm drum machine. Other work includes firmware for Eurorack modules, a browser-based techno loop generator, and LEMON AUDIO, a music platform.',
	ink: 'hatch3d turns 3D surfaces into hatching for an AxiDraw pen plotter. InkSight creates reports that help coding agents inspect plotter SVGs.',
	agents: 'Lemon Agent is a course on safe coding-agent work. lookout, skiff, nanoclaw, and the rest of the software stack support agents running on the Mac mini in the closet.',
	play: "feltmath is a blackjack and hold'em trainer. Typing Arena is a local multiplayer typing game. BrightPath Global Solutions is a consultancy that does not exist.",
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="sheet">
				<div class="hero">
					<Hatch spacing={9} style="surface" class="hero-surface" />
					<div class="hero-copy">
						<span class="stamp">Nick Donohue</span>
						<h1><span class="word">algonormative</span></h1>
						<p>{SITE_DESCRIPTION}</p>
						<ul class="socials">
							<li><a href="https://github.com/algonormative" target="_blank" rel="me noopener">GitHub</a></li>
							<li><a href="https://x.com/algonormative" target="_blank" rel="me noopener">X</a></li>
							<li><a href="https://www.linkedin.com/in/nick-donohue-56801871/" target="_blank" rel="me noopener">LinkedIn</a></li>
							<li><a href="mailto:nick@algonormative.net">Email</a></li>
							<li><a href="/rss.xml">RSS</a></li>
						</ul>
					</div>
				</div>

				<section class="promo" aria-labelledby="promo-title">
					<div class="promo-copy">
						<span class="eyebrow">New art set · Ink</span>
						<h2 id="promo-title"><a href="/breach#cathedral">Breach Cathedral</a></h2>
						<p>Slab architecture, interrupted by a living helix. The newest one moves.</p>
						<span class="promo-meta mono">7 sheets · 11 × 17 in · SVG</span>
						<div class="promo-links">
							<a class="go" href="/breach#cathedral">See the set →</a>
							<a class="go" href="/breach/plenipotentiary">Plenipotentiary, live →</a>
						</div>
					</div>
					<ul class="promo-sheets">
						{
							promoSheets.map((sheet) => (
								<li>
									<a href={sheet.href}>
										<Image src={sheet.src} widths={[200, 400]} sizes="(max-width: 720px) 30vw, 220px" alt={sheet.alt} />
										<span class="mono">{sheet.label}</span>
									</a>
								</li>
							))
						}
					</ul>
				</section>

				<div class="plates">
					{
						domains.map((domain, i) => (
							<a class="plate" href={`/${domain.slug}`}>
								<span class="n mono">plate {i + 1}</span>
								<Hatch seed={domain.slug} style={domain.slug} class="plate-surface" />
								<h2>{domain.name}</h2>
								<p>{plateBlurbs[domain.slug]}</p>
							</a>
						))
					}
				</div>

				<div class="index">
					<div class="index-head">
						<span class="eyebrow">Recent writing</span>
						<a class="mono" href="/writing">all posts</a>
					</div>
					{
						recent.length === 0 ? (
							<p class="empty">
								First post in flight. Subscribe to the <a href="/rss.xml">RSS feed</a> or check
								back soon.
							</p>
						) : (
							<ul class="rows">
								{recent.map((post) => (
									<li>
										<a class="t" href={post.href}>
											{post.data.title} <small>{post.kind}</small>
										</a>
										<span class="row-meta mono">
											<FormattedDate date={post.data.pubDate} />
										</span>
									</li>
								))}
							</ul>
						)
					}
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 1120px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: var(--space-l) 0 0;
	}
	.sheet {
		border: 1px solid var(--rule);
	}

	.hero {
		position: relative;
		height: clamp(320px, 46vw, 460px);
		overflow: hidden;
		border-bottom: 1px solid var(--rule);
		background: var(--bg);
	}
	.hero :global(.hero-surface) {
		position: absolute;
		inset: 0;
	}
	/* Fade the surface toward the paper where the copy sits and along the
	   bottom edge, so the drawing frames the words instead of competing. */
	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			linear-gradient(90deg, var(--bg) 0%, transparent 46%),
			linear-gradient(0deg, var(--bg) 0%, transparent 42%),
			linear-gradient(180deg, var(--bg) 0%, transparent 18%);
	}
	.hero-copy {
		position: absolute;
		z-index: 1;
		left: var(--space-m);
		right: var(--space-m);
		bottom: var(--space-m);
		display: grid;
		gap: var(--space-2xs);
		max-width: 34rem;
		justify-items: start;
	}
	.hero-copy h1 {
		margin: 0;
		font-size: clamp(2.2rem, 7vw, 4.4rem);
		font-weight: 800;
		font-variation-settings: 'opsz' 96;
		line-height: 1.05;
	}
	.hero-copy .word {
		display: inline-block;
		background: var(--bg);
		padding: 0.1em 0.25em 0.05em;
		margin-left: -0.25em;
	}
	.hero-copy p {
		background: var(--bg);
		display: inline;
		padding: 0.15em 0.35em;
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
		font-size: 1rem;
		line-height: 1.85;
		margin: 0;
	}

	.promo {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
		gap: var(--space-l);
		align-items: center;
		padding: var(--space-l) var(--space-m);
	}
	.promo-copy {
		display: grid;
		gap: var(--space-2xs);
		justify-items: start;
		min-width: 0;
	}
	.promo h2 {
		margin: 0;
		font-size: clamp(1.9rem, 4vw, 2.6rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.05;
		text-wrap: balance;
	}
	.promo h2 a {
		color: var(--fg);
		text-decoration: none;
	}
	.promo p {
		margin: 0;
		max-width: 46ch;
	}
	.promo-meta {
		font-size: 0.75rem;
		color: var(--muted);
	}
	.promo-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2xs) var(--space-m);
		margin-top: var(--space-3xs);
	}
	.promo-links .go {
		font-weight: 700;
	}
	.promo-sheets {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr));
		align-items: end;
		gap: var(--space-s);
	}
	.promo-sheets li {
		min-width: 0;
	}
	.promo-sheets a {
		display: grid;
		gap: var(--space-3xs);
		color: var(--muted);
		text-decoration: none;
		font-size: 0.7rem;
		min-width: 0;
	}
	.promo-sheets span {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.promo-sheets img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 279.4 / 431.8;
		object-fit: cover;
		border: 1px solid var(--rule);
		transition: transform 0.25s ease;
	}
	.promo-sheets a:hover img,
	.promo-sheets a:focus-visible img {
		transform: translateY(-4px);
	}
	.promo-sheets a:hover span {
		color: var(--fg);
	}
	@media (max-width: 760px) {
		.promo {
			grid-template-columns: 1fr;
			padding: var(--space-m) var(--space-s);
		}
		.promo-sheets {
			gap: var(--space-2xs);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.promo-sheets img {
			transition: none;
		}
	}

	.plates {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
	}
	.plate {
		border-top: 1px solid var(--rule);
		border-right: 1px solid var(--rule);
		padding: var(--space-l) var(--space-s) var(--space-s);
		display: grid;
		gap: var(--space-2xs);
		align-content: start;
		position: relative;
		min-height: 250px;
		text-decoration: none;
		color: var(--fg);
	}
	.plate:last-child {
		border-right: none;
	}
	.plate :global(.plate-surface) {
		height: 88px;
		border: 1px solid var(--rule);
	}
	.plate h2 {
		font-size: 1.5rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		margin: var(--space-3xs) 0 0;
	}
	.plate p {
		color: var(--muted);
		font-size: 0.95rem;
		line-height: 1.45;
		margin: 0;
	}
	.plate .n {
		position: absolute;
		top: var(--space-s);
		right: var(--space-s);
		color: var(--muted);
	}
	.plate:hover h2,
	.plate:focus-visible h2 {
		text-decoration: underline;
		text-decoration-color: var(--lemon);
		text-decoration-thickness: 3px;
		text-underline-offset: 0.12em;
	}

	.index {
		border-top: 1px solid var(--rule);
		padding: var(--space-s) var(--space-m) var(--space-m);
	}
	.index-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-s);
		margin-bottom: var(--space-2xs);
	}
	.index-head a {
		text-decoration: none;
		color: var(--muted);
	}
	.index-head a:hover {
		color: var(--fg);
		box-shadow: inset 0 -3px 0 var(--lemon);
	}
	.rows {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.rows li {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: var(--space-s);
		padding: var(--space-2xs) 0;
		border-top: 1px solid var(--rule);
		align-items: baseline;
	}
	.rows li:last-child {
		border-bottom: 1px solid var(--rule);
	}
	.rows .t {
		font-weight: 700;
		color: var(--fg);
		text-decoration: none;
	}
	.rows .t:hover {
		box-shadow: inset 0 -3px 0 var(--lemon);
	}
	.rows .t small {
		font-weight: 400;
		color: var(--muted);
		font-size: 0.9rem;
	}
	.row-meta {
		color: var(--muted);
		white-space: nowrap;
	}
	.empty {
		color: var(--muted);
		margin: 0;
		padding: var(--space-s) 0;
	}

	@media (max-width: 640px) {
		.hero-copy {
			left: var(--space-s);
			right: var(--space-s);
			bottom: var(--space-s);
		}
	}
	/* Socials: small paper chips so the links read over the hatching */
	.socials {
		list-style: none;
		margin: var(--space-3xs) 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3xs);
	}
	.socials a {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.04em;
		color: var(--fg);
		background: var(--bg);
		border: 1px solid var(--rule);
		padding: 0.3em 0.6em;
		text-decoration: none;
	}
	.socials a:hover,
	.socials a:focus-visible {
		border-color: var(--fg);
		box-shadow: inset 0 -3px 0 var(--lemon);
	}
</style>
