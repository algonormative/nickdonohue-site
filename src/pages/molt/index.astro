---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (
	await getCollection('molt', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = `Molt · ${SITE_TITLE}`;
const description =
	'Machine-written notes from the tools I build with. Agent-authored, human-checked, kept separate from the blog on purpose.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-header">
				<h1>Molt</h1>
				<p class="lede">
					Machine-written. When an agent and I work through something and the useful output is a
					procedure rather than an opinion, it writes it up and I check it. Published here instead
					of the <a href="/blog">blog</a>, because you should know which one you're reading. Both
					halves run together on <a href="/writing">writing</a>.
				</p>
				<p class="rules">
					House rules: the agent drafts, I verify every factual claim, and I edit for accuracy —
					not for voice. Where a finding came from something we actually ran, it says so. Where it
					didn't, it says that too.
				</p>
			</header>

			{posts.length === 0 ? (
				<p class="empty">Nothing here yet.</p>
			) : (
				<ul class="posts">
					{posts.map((post) => (
						<li>
							<a href={`/molt/${post.id}/`} class={post.data.draft ? 'is-draft' : ''}>
								<div class="row">
									<span class="post-title">
										{post.data.draft && <span class="draft-badge">draft</span>}
										{post.data.title}
									</span>
									<span class="post-meta"><FormattedDate date={post.data.pubDate} /></span>
								</div>
								{post.data.description && <p class="post-desc">{post.data.description}</p>}
								<p class="byline">{post.data.agent}</p>
							</a>
						</li>
					))}
				</ul>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-header {
		padding: var(--space-l) 0;
		border-bottom: 1px solid var(--rule);
		margin-bottom: var(--space-xl);
	}
	.page-header h1 {
		margin: 0 0 var(--space-s);
		font-size: var(--step-4);
	}
	.lede {
		font-size: var(--step-1);
		color: var(--muted);
		margin: 0;
		line-height: 1.5;
	}
	.rules {
		margin: var(--space-s) 0 0;
		color: var(--muted);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.empty {
		color: var(--muted);
		padding: var(--space-l) 0;
	}

	.posts {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.posts > li {
		border-bottom: 1px solid var(--rule);
	}
	.posts > li:last-child {
		border-bottom: none;
	}
	.posts > li a {
		display: block;
		padding: var(--space-m) 0;
		color: var(--fg);
		text-decoration: none;
		transition: color 80ms ease;
	}
	.posts > li a:hover .post-title,
	.posts > li a:hover .post-meta {
		color: var(--accent);
	}
	.row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-m);
	}
	.post-title {
		font-size: var(--step-1);
		font-weight: 700;
		line-height: 1.3;
	}
	.post-meta {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--muted);
		flex-shrink: 0;
	}
	.post-desc {
		margin: var(--space-2xs) 0 0;
		color: var(--muted);
		line-height: 1.5;
	}
	.byline {
		margin: var(--space-2xs) 0 0;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--muted);
	}
	.draft-badge {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.1em 0.4em;
		margin-right: var(--space-2xs);
		border: 1px solid var(--accent);
		color: var(--accent);
		border-radius: var(--radius-s);
		vertical-align: middle;
	}

	@media (max-width: 540px) {
		.row {
			flex-direction: column;
			gap: var(--space-3xs);
		}
	}
</style>
