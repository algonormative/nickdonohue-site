---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import domains from '../data/domains.json';
import projects from '../data/projects.json';

const groups = domains.map((domain) => ({
	domain,
	items: projects
		.filter((p) => p.domain === domain.slug)
		.sort((a, b) => Number(b.featured) - Number(a.featured)),
}));

const title = `Projects · ${SITE_TITLE}`;
const description = 'Everything, in one index. Personal tools for sound, ink, agents, and play.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<header class="titleblock">
				<div>
					<div class="eyebrow">Index · every plate</div>
					<h1>Projects</h1>
				</div>
				<div class="tb mono">
					<span><b>Entries</b>{projects.length}</span>
					<span><b>Plates</b>{domains.length}</span>
					<span><b>Source</b><a href="https://github.com/algonormative" target="_blank" rel="noopener">GitHub</a></span>
				</div>
			</header>

			<p class="lede">
				Everything in one place. Each group has its own plate with more detail: {
					domains.map((d, i) => (
						<><a href={`/${d.slug}`}>{d.name.toLowerCase()}</a>{i < domains.length - 1 ? ', ' : '.'}</>
					))
				}
			</p>

			{
				groups.map(({ domain, items }) => (
					<section class="group">
						<div class="section-head">
							<h2>
								<a href={`/${domain.slug}`}>{domain.name}</a>
							</h2>
							<span class="mono">/{domain.slug}</span>
						</div>
						<ul class="rows">
							{items.map((project) => (
								<li>
									<span class="t">
										<span class="name">{project.name}</span>
										<span class="tagline"> {project.tagline}</span>
									</span>
									<span class="row-meta mono">
										{project.live && (
											<a href={project.live} target="_blank" rel="noopener">
												live
											</a>
										)}
										{project.source && (
											<a href={project.source} target="_blank" rel="noopener">
												source
											</a>
										)}
									</span>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 1120px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 0 0 var(--space-l);
	}

	.titleblock {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: var(--space-s) var(--space-l);
		border-bottom: 2px solid var(--fg);
		padding: var(--space-m) 0 var(--space-xs);
		align-items: end;
	}
	.titleblock h1 {
		margin: var(--space-3xs) 0 0;
		font-size: clamp(2rem, 5vw, 3.2rem);
		font-variation-settings: 'opsz' 72;
	}
	.tb {
		display: grid;
		grid-template-columns: auto auto auto;
		gap: var(--space-3xs) var(--space-m);
		text-align: right;
		color: var(--muted);
	}
	.tb b {
		color: var(--fg);
		font-weight: 600;
		display: block;
	}
	@media (max-width: 720px) {
		.titleblock {
			grid-template-columns: 1fr;
		}
		.tb {
			text-align: left;
		}
	}

	.lede {
		max-width: var(--measure);
		font-size: 1.1rem;
		line-height: 1.6;
		margin: var(--space-l) 0 0;
	}

	.group {
		margin-top: var(--space-xl);
	}
	.section-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-s);
		border-bottom: 1px solid var(--rule);
		padding-bottom: var(--space-3xs);
	}
	.section-head h2 {
		margin: 0;
		font-size: 1.4rem;
		font-weight: 800;
	}
	.section-head h2 a {
		color: var(--fg);
		text-decoration: none;
	}
	.section-head h2 a:hover {
		box-shadow: inset 0 -3px 0 var(--lemon);
	}
	.section-head .mono {
		color: var(--muted);
	}

	.rows {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.rows > li {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: var(--space-s);
		padding: var(--space-2xs) 0;
		border-top: 1px solid var(--rule);
		align-items: baseline;
	}
	.rows > li:first-child {
		border-top: none;
	}
	.name {
		font-weight: 700;
	}
	.tagline {
		color: var(--muted);
		font-size: 0.95rem;
	}
	.row-meta {
		color: var(--muted);
		white-space: nowrap;
		display: inline-flex;
		gap: var(--space-2xs);
	}
	.row-meta a {
		color: var(--accent);
		text-decoration: none;
		border-bottom: 1px solid var(--rule);
	}
	.row-meta a:hover,
	.row-meta a:focus-visible {
		border-bottom-color: var(--lemon);
		border-bottom-width: 3px;
	}

	@media (max-width: 560px) {
		.rows > li {
			grid-template-columns: 1fr;
			gap: var(--space-3xs);
		}
	}
</style>
