---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (
	await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = `Blog · ${SITE_TITLE}`;
const description = 'Notes on AI tooling, creative work, and the systems behind both.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-header">
				<h1>Blog</h1>
				<p class="lede">
					Long-form notes, all mine. Aiming for biweekly. <a href="/rss.xml">RSS</a> if you want
					to follow, or read <a href="/writing">everything</a> in one stream.
				</p>
			</header>

			{posts.length === 0 ? (
				<p class="empty">Nothing here yet. The first post is in flight.</p>
			) : (
				<ul class="posts">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`} class={post.data.draft ? 'is-draft' : ''}>
								<div class="row">
									<span class="post-title">
										{post.data.draft && <span class="draft-badge">draft</span>}
										{post.data.title}
									</span>
									<span class="post-meta"><FormattedDate date={post.data.pubDate} /></span>
								</div>
								{post.data.description && <p class="post-desc">{post.data.description}</p>}
								{post.data.tags && post.data.tags.length > 0 && (
									<ul class="tags">
										{post.data.tags.map((tag) => <li>{tag}</li>)}
									</ul>
								)}
							</a>
						</li>
					))}
				</ul>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-header {
		padding: var(--space-l) 0;
		border-bottom: 1px solid var(--rule);
		margin-bottom: var(--space-xl);
	}
	.page-header h1 {
		margin: 0 0 var(--space-s);
		font-size: var(--step-4);
	}
	.lede {
		font-size: var(--step-1);
		color: var(--muted);
		margin: 0;
		line-height: 1.5;
	}

	.empty {
		color: var(--muted);
		padding: var(--space-l) 0;
	}

	.posts {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.posts > li {
		border-bottom: 1px solid var(--rule);
	}
	.posts > li:last-child {
		border-bottom: none;
	}
	.posts > li a {
		display: block;
		padding: var(--space-m) 0;
		color: var(--fg);
		text-decoration: none;
		transition: color 80ms ease;
	}
	.posts > li a:hover .post-title,
	.posts > li a:hover .post-meta {
		color: var(--accent);
	}
	.row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-m);
	}
	.post-title {
		font-size: var(--step-1);
		font-weight: 700;
		line-height: 1.3;
	}
	.post-meta {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--muted);
		flex-shrink: 0;
	}
	.post-desc {
		margin: var(--space-2xs) 0 0;
		color: var(--muted);
		line-height: 1.5;
	}
	.draft-badge {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.1em 0.4em;
		margin-right: var(--space-2xs);
		border: 1px solid var(--accent);
		color: var(--accent);
		border-radius: var(--radius-s);
		vertical-align: middle;
	}
	.tags {
		list-style: none;
		padding: 0;
		margin: var(--space-2xs) 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3xs);
	}
	.tags > li {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--muted);
	}
	.tags > li::before {
		content: '#';
	}

	@media (max-width: 540px) {
		.row {
			flex-direction: column;
			gap: var(--space-3xs);
		}
	}
</style>
