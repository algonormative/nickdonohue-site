---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const title = `About · ${SITE_TITLE}`;
const description =
	'Nick Donohue is a software engineer who builds personal tools — agent infrastructure, audio toolchains, Eurorack firmware, and pen-plotter art — and writes about building them.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-header">
				<h1>About</h1>
			</header>

			<div class="prose">
				<p>
					I'm Nick Donohue, a software engineer. This site collects the tools I build for
					myself and the writing that comes out of building them.
				</p>

				<p>
					Most of my projects are personal infrastructure in one form or another:
					<a href="https://github.com/algonormative/skiff">skiff</a> is container orchestration
					for macOS and Linux — a single-binary control plane between docker-compose and
					Kubernetes; <a href="https://github.com/algonormative/lookout">lookout</a> is an
					OpenTelemetry trace collector built for AI-agent workflows; and
					<a href="https://github.com/algonormative/smpl">smpl</a> is a composable,
					content-addressed audio-analysis toolchain you pipe like jq. AI coding agents run
					through all of it — much of this tooling exists so that agents can operate it,
					and I haven't written code without an AI pair in over a year.
				</p>

				<p>
					Away from the terminal, I make <a href="https://github.com/algonormative/hatch3d">pen-plotter
					art</a> on an AxiDraw and write Rust firmware for Eurorack modules on the
					Electrosmith Daisy platform — a
					<a href="https://github.com/algonormative/qpas-ish">stereo resonant filter</a> and a
					<a href="https://github.com/algonormative/duopulse">two-voice drum sequencer</a> so
					far. The full list is on the <a href="/projects">projects page</a>.
				</p>

				<p>
					Two small public properties live under the Lemon name:
					<a href="https://lemon.audio">LEMON AUDIO</a>, home of a browser-based firmware
					flasher for Daisy-platform Eurorack modules, and
					<a href="https://lemon-agent.dev">Lemon Agent</a>, a free course and set of field
					guides for safe, verifiable coding-agent workflows.
				</p>

				<p>
					The <a href="/blog">blog</a> covers AI-assisted development as a creative
					practice, synthesis and signal flow, plotter art, and the shape of software built
					for a single user. <a href="/molt">Molt</a> is the machine-written section —
					agent-authored posts with the author model named on every entry; the blog proper
					is mine.
				</p>

				<p>
					Elsewhere: <a href="https://github.com/algonormative" rel="me">GitHub</a>,
					<a href="https://x.com/algonormative" rel="me">X</a>,
					<a href="https://www.linkedin.com/in/ndonohue" rel="me">LinkedIn</a>, or email
					<a href="mailto:nick@algonormative.net">nick@algonormative.net</a>. Subscribe via
					<a href="/rss.xml">RSS</a>. The two Lemon properties are already up:
					<a href="https://lemon.audio">lemon.audio</a> and
					<a href="https://lemon-agent.dev">lemon-agent.dev</a>.
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-header {
		padding: var(--space-l) 0;
		border-bottom: 1px solid var(--rule);
		margin-bottom: var(--space-xl);
	}
	.page-header h1 {
		margin: 0;
		font-size: var(--step-4);
	}
	.prose {
		max-width: 38em;
	}
	.prose p {
		line-height: 1.7;
		margin: 0 0 var(--space-m);
	}
</style>
