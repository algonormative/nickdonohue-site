---
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import tarot from '../data/breach-tarot.json';

// The web masters are the print-queue renders (tabloid sheets) and the print
// proof's fronts cut to the trim line (pocket deck). Astro sizes them per slot.
const byName = (files: Record<string, { default: ImageMetadata }>) =>
	Object.fromEntries(
		Object.entries(files).map(([file, mod]) => [file.split('/').pop()!.replace('.webp', ''), mod.default]),
	);
const sheets = byName(import.meta.glob('../assets/breach/tarot/*.webp', { eager: true }));
const cathedralSheets = byName(import.meta.glob('../assets/breach/cathedral/*.webp', { eager: true }));
const pocket = byName(import.meta.glob('../assets/breach/pocket/*.webp', { eager: true }));

const full = async (src: ImageMetadata) => (await getImage({ src, width: Math.min(1400, src.width), format: 'webp' })).src;

const cards = await Promise.all(
	tarot.cards.map(async (card) => ({
		...card,
		sheet: sheets[card.file],
		small: pocket[card.pocket],
		zoom: await full(sheets[card.file]),
		smallZoom: await full(pocket[card.pocket]),
	})),
);

const cathedral = [
	{ key: 'cathedral-c001', label: 'c001', seed: 219 },
	{ key: 'cathedral-c033', label: 'c033', seed: 613 },
	{ key: 'cathedral-c004', label: 'c004', seed: 792 },
	{ key: 'cathedral-c044', label: 'c044', seed: 430 },
	{ key: 'cathedral-c019', label: 'c019', seed: 369 },
];
const cathedralZoom = Object.fromEntries(
	await Promise.all(Object.entries(cathedralSheets).map(async ([k, src]) => [k, await full(src)])),
);
const backZoom = await full(pocket.back);

// Plotter-ready SVGs (one layer per pen, in mm) live in public/breach/svg.
const svg = (name: string) => `/breach/svg/${name}.svg`;

const title = `Breach · ${SITE_TITLE}`;
const description =
	'Breach Cathedral and the Breach Tarot: pen-plotter drawings of slab architecture interrupted by a living helix, all twenty-two Major Arcana, and a pocket deck for print.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={sheets['xvii-star']} />
	</head>
	<body>
		<Header />
		<main class="breach">
			<header class="titleblock">
				<div>
					<div class="eyebrow"><a href="/ink#plotter-art">Ink · All plotter art</a></div>
					<h1>Breach</h1>
				</div>
				<div class="tb mono">
					<span><b>Works</b>{7 + 2 * cards.length + 1}</span>
					<span><b>Files</b>SVG</span>
					<span><b>Source</b><a href="https://github.com/algonormative/hatch3d" target="_blank" rel="noopener">hatch3d</a></span>
				</div>
			</header>

			<p class="lede">Pen-plotter drawings. Slab architecture, interrupted by a living helix.</p>

			<nav class="jump mono" aria-label="On this page">
				<a href="#cathedral">Breach Cathedral</a>
				<a href="#tarot">Breach Tarot</a>
				<a href="#pocket">Pocket deck</a>
				<a href="#files">SVGs</a>
			</nav>

			<section id="cathedral" class="part">
				<div class="section-head">
					<h2>Breach Cathedral</h2>
					<span class="mono">7 sheets</span>
				</div>

				<div class="pair">
					<figure class="sheet-fig">
						<button class="zoomable" type="button" data-full={cathedralZoom['tower-211']} aria-label="Enlarge Tower, seed 211">
							<Image
								src={cathedralSheets['tower-211']}
								widths={[480, 800, 1200]}
								sizes="(max-width: 720px) 100vw, 540px"
								alt="Breach Cathedral: Tower, seed 211. A full-height tower of cantilevered slabs with a twin helix wound through its shaft and a band where the stack shears and falls."
							/>
						</button>
						<figcaption class="mono"><span><b>Tower</b> · seed 211</span><a href={svg('breach-cathedral-tower-211-11x17in')} download>SVG</a></figcaption>
					</figure>
					<figure class="sheet-fig" id="plenipotentiary">
						<button class="zoomable" type="button" data-full={cathedralZoom['agent-3']} aria-label="Enlarge Plenipotentiary">
							<Image
								src={cathedralSheets['agent-3']}
								widths={[480, 800, 1200]}
								sizes="(max-width: 720px) 100vw, 540px"
								alt="Plenipotentiary: a seated pinstripe-suited figure with a helix head and a hatched censor bar over its eyes, on a slab throne inside the cathedral."
							/>
						</button>
						<figcaption class="mono">
							<span><b>Plenipotentiary</b> · seed 3</span>
							<span><a href="/breach/plenipotentiary">live →</a> · <a href={svg('plenipotentiary-11x17in')} download>SVG</a></span>
						</figcaption>
					</figure>
				</div>

				<div class="row5">
					{
						cathedral.map((c) => (
							<figure class="sheet-fig">
								<button class="zoomable" type="button" data-full={cathedralZoom[c.key]} aria-label={`Enlarge Breach Cathedral ${c.label}`}>
									<Image
										src={cathedralSheets[c.key]}
										widths={[240, 480]}
										sizes="(max-width: 520px) 50vw, (max-width: 900px) 33vw, 210px"
										alt={`Breach Cathedral ${c.label}, seed ${c.seed}`}
										loading="lazy"
									/>
								</button>
								<figcaption class="mono"><span><b>{c.label}</b> · s{c.seed}</span><a href={svg(`breach-${c.key}-11x17in`)} download>SVG</a></figcaption>
							</figure>
						))
					}
				</div>
			</section>

			<section id="tarot" class="part">
				<div class="section-head">
					<h2>Breach Tarot</h2>
					<span class="mono">22 sheets</span>
				</div>
				<p class="lede">The Major Arcana, built from the cathedral's parts.</p>

				<ol class="gallery" aria-label="The deck">
					{
						cards.map((card) => (
							<li class="card" id={card.slug}>
								<figure class="sheet-fig">
									<button class="zoomable" type="button" data-full={card.zoom} aria-label={`Enlarge ${card.name}`}>
										<Image src={card.sheet} widths={[320, 640]} sizes="(max-width: 520px) 50vw, (max-width: 900px) 33vw, 260px" alt={card.alt} loading="lazy" />
									</button>
									<figcaption class="mono">
										<span><b>{card.numeral}</b> {card.name}</span>
										<a href={svg(`breach-tarot-${card.file}-11x17in`)} download>SVG</a>
									</figcaption>
									<p class="phrase">{card.phrase}</p>
								</figure>
							</li>
						))
					}
				</ol>
			</section>

			<section id="pocket" class="part">
				<div class="section-head">
					<h2>Pocket deck</h2>
					<span class="mono">70 × 120 mm</span>
				</div>
				<p class="lede">The same twenty-two cards redrawn at tarot size, with one back.</p>

				<ol class="pocket-grid" aria-label="Pocket deck">
					{
						cards.map((card) => (
							<li>
								<button class="zoomable" type="button" data-full={card.smallZoom} aria-label={`Enlarge pocket ${card.name}`}>
									<Image
										src={card.small}
										widths={[200, 400]}
										sizes="(max-width: 900px) 25vw, 100px"
										alt={`${card.numeral} ${card.name}, pocket size, with the phrase “${card.phrase}” under the name`}
										loading="lazy"
									/>
								</button>
								<a class="mono" href={svg(`breach-tarot-${card.file}-70x120mm`)} download>SVG</a>
							</li>
						))
					}
					<li class="back">
						<button class="zoomable" type="button" data-full={backZoom} aria-label="Enlarge the card back">
							<Image
								src={pocket.back}
								widths={[200, 400]}
								sizes="(max-width: 900px) 25vw, 100px"
								alt="The card back: a round labyrinth with a star at its centre, a red, green and gold helix winding in and out of it and around three slabs above and three below, symmetric top to bottom."
								loading="lazy"
							/>
						</button>
						<a class="mono" href={svg('breach-tarot-back-70x120mm')} download>back · SVG</a>
					</li>
				</ol>
			</section>

			<section id="files" class="part">
				<div class="section-head">
					<h2>SVGs</h2>
					<span class="mono">52 files</span>
				</div>
				<p class="lede">
					Plotter files in millimetres at paper size, one Inkscape layer per pen. Each is signed bottom-right with
					its edition, hatch3d commit and date.
				</p>
			</section>

			<p class="colophon mono">
				Each sketch is TypeScript in hatch3d, written with Claude to Nick's briefs and picks. The images are
				renders; the sheets are not yet plotted.
			</p>
		</main>

		<dialog class="zoom" aria-label="Enlarged image">
			<form method="dialog"><button class="close mono" type="submit">close</button></form>
			<img alt="" />
		</dialog>

		<Footer />

		<script>
			const dialog = document.querySelector<HTMLDialogElement>('dialog.zoom');
			const big = dialog?.querySelector('img');
			if (dialog && big) {
				document.querySelectorAll<HTMLButtonElement>('button.zoomable').forEach((button) => {
					button.addEventListener('click', () => {
						const img = button.querySelector('img');
						big.src = button.dataset.full ?? img?.currentSrc ?? '';
						big.alt = img?.alt ?? '';
						dialog.showModal();
					});
				});
				// A click anywhere closes it, the image included: it is a viewer, not a form.
				dialog.addEventListener('click', () => dialog.close());
			}
		</script>
	</body>
</html>

<style>
	/* The five plotter inks, as the pens lay them down on warm stock; brighter on blueprint. */
	.breach {
		--pen-carbon: #22282c;
		--pen-ultramarine: #3c49aa;
		--pen-vermilion: #d04b3c;
		--pen-acid: #8c9020;
		--pen-violet: #776090;
		--paper: #f4f0e6;
	}
	:global([data-theme='dark']) .breach {
		--pen-carbon: #c9ccd4;
		--pen-ultramarine: #8f9bf0;
		--pen-vermilion: #f0806f;
		--pen-acid: #c9cd5f;
		--pen-violet: #b49ed0;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme])) .breach {
			--pen-carbon: #c9ccd4;
			--pen-ultramarine: #8f9bf0;
			--pen-vermilion: #f0806f;
			--pen-acid: #c9cd5f;
			--pen-violet: #b49ed0;
		}
	}

	main {
		width: 1120px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 0 0 var(--space-l);
	}

	.titleblock {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: var(--space-s) var(--space-l);
		border-bottom: 2px solid var(--fg);
		padding: var(--space-m) 0 var(--space-xs);
		align-items: end;
	}
	.titleblock h1 {
		margin: var(--space-3xs) 0 0;
		font-size: clamp(2rem, 5vw, 3.2rem);
		font-variation-settings: 'opsz' 72;
	}
	.titleblock .eyebrow a {
		color: inherit;
	}
	.tb {
		display: grid;
		grid-template-columns: auto auto auto;
		gap: var(--space-3xs) var(--space-m);
		text-align: right;
		color: var(--muted);
	}
	.tb b {
		color: var(--fg);
		font-weight: 600;
		display: block;
	}

	.lede {
		max-width: var(--measure);
		font-size: 1.1rem;
		line-height: 1.6;
		margin: var(--space-l) 0 0;
	}

	.jump {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2xs) var(--space-m);
		margin-top: var(--space-m);
		padding-top: var(--space-xs);
		border-top: 1px solid var(--rule);
	}

	.part {
		margin-top: var(--space-2xl);
		display: grid;
		gap: var(--space-l);
	}
	.part > .lede {
		margin: 0;
	}
	.section-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-s);
		border-bottom: 2px solid var(--fg);
		padding-bottom: var(--space-3xs);
	}
	.section-head h2 {
		margin: 0;
		font-size: clamp(1.6rem, 3.6vw, 2.4rem);
	}
	.section-head .mono {
		color: var(--muted);
	}

	h3 {
		margin: 0;
		font-size: clamp(1.5rem, 3vw, 2rem);
		text-wrap: balance;
	}

	/* A sheet is a print on the wall: its own warm stock, one soft shadow, no frame. */
	.sheet-fig {
		margin: 0;
		display: grid;
		gap: var(--space-2xs);
		min-width: 0;
	}
	.zoomable {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: var(--paper);
		cursor: zoom-in;
		box-shadow:
			0 1px 0 rgba(0, 0, 0, 0.08),
			0 14px 30px -18px rgba(0, 0, 0, 0.5);
		transition: transform 0.2s ease;
	}
	.zoomable:hover {
		transform: translateY(-3px);
	}
	.zoomable:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}
	.zoomable :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
	figcaption {
		display: flex;
		justify-content: space-between;
		gap: var(--space-xs);
		flex-wrap: wrap;
		color: var(--muted);
	}
	figcaption b {
		color: var(--fg);
		font-weight: 600;
	}

	.pair {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1rem, 3vw, 2.5rem);
		margin-bottom: clamp(1.5rem, 4vw, 3rem);
		align-items: end;
	}
	.row5 {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: clamp(0.75rem, 2vw, 1.5rem);
	}

	.gallery {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(1.25rem, 3vw, 2.25rem) clamp(0.75rem, 2vw, 1.5rem);
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.card {
		scroll-margin-top: var(--space-m);
		min-width: 0;
	}
	.phrase {
		margin: 0;
		font-style: italic;
		font-size: 0.85rem;
		line-height: 1.4;
		color: var(--muted);
	}

	.back .zoomable,
	.pocket-grid .zoomable {
		border-radius: 3.5% / 2%;
		overflow: hidden;
	}
	.pocket-grid {
		display: grid;
		grid-template-columns: repeat(8, minmax(0, 1fr));
		gap: clamp(0.6rem, 1.5vw, 1rem);
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.pocket-grid li {
		display: grid;
		gap: 0.3rem;
		justify-items: start;
		min-width: 0;
	}
	.pocket-grid a {
		font-size: 0.65rem;
		color: var(--muted);
	}

	.colophon {
		margin: var(--space-2xl) 0 0;
		max-width: 72ch;
		color: var(--muted);
		line-height: 1.7;
		border-left: 3px solid var(--lemon);
		padding-left: var(--space-xs);
	}

	.zoom {
		border: 0;
		padding: 0;
		background: transparent;
		max-width: 100vw;
		max-height: 100vh;
		width: 100vw;
		height: 100vh;
		cursor: zoom-out;
	}
	.zoom::backdrop {
		background: rgba(10, 12, 18, 0.9);
	}
	.zoom[open] {
		display: grid;
		place-items: center;
	}
	.zoom img {
		max-width: calc(100vw - 2rem);
		max-height: calc(100vh - 4rem);
		width: auto;
		height: auto;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
	}
	.zoom form {
		position: fixed;
		top: calc(env(safe-area-inset-top, 0px) + 0.75rem);
		right: 1rem;
	}
	.close {
		background: var(--bg);
		color: var(--fg);
		border: 1px solid var(--rule);
		padding: 0.3em 0.7em;
		cursor: pointer;
	}

	@media (max-width: 900px) {
		.row5,
		.gallery {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.pocket-grid {
			grid-template-columns: repeat(6, minmax(0, 1fr));
		}
	}
	@media (max-width: 720px) {
		.titleblock {
			grid-template-columns: 1fr;
		}
		.tb {
			text-align: left;
		}
	}
	@media (max-width: 520px) {
		.pair {
			grid-template-columns: 1fr;
		}
		.row5,
		.gallery {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.pocket-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.zoomable {
			transition: none;
		}
		.zoomable:hover {
			transform: none;
		}
	}
</style>
