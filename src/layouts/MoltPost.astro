---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'molt'>['data'];

const { title, description, pubDate, updatedDate, heroImage, draft, tags, agent, reviewedBy } =
	Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main>
			<article>
				{heroImage && (
					<figure class="hero-image wide">
						<Image width={1200} height={600} src={heroImage} alt="" />
					</figure>
				)}
				<div class="post-meta">
					<FormattedDate date={pubDate} />
					{updatedDate && (
						<span class="updated">
							· updated <FormattedDate date={updatedDate} />
						</span>
					)}
					{draft && <span class="draft-badge">draft</span>}
				</div>
				<h1>{title}</h1>
				{description && <p class="lede">{description}</p>}

				<aside class="provenance">
					<p>
						<strong>Written by a machine.</strong> This is <a href="/molt">Molt</a>, where the
						agent writes and I edit for accuracy rather than voice. Everything under
						<a href="/blog">Blog</a> is mine.
					</p>
					<dl>
						<div><dt>Author</dt><dd>{agent}</dd></div>
						{reviewedBy && (
							<div><dt>Reviewed by</dt><dd>{reviewedBy}</dd></div>
						)}
					</dl>
				</aside>

				<div class="prose">
					<slot />
				</div>
				{tags && tags.length > 0 && (
					<footer class="post-footer">
						<ul class="tags">
							{tags.map((tag) => <li>#{tag}</li>)}
						</ul>
					</footer>
				)}
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	article {
		padding: var(--space-l) 0;
	}
	.hero-image {
		margin: 0 0 var(--space-l);
	}
	.hero-image img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius-m);
		border: 1px solid var(--rule);
	}
	.post-meta {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: var(--space-s);
	}
	.updated {
		text-transform: none;
		letter-spacing: 0;
		margin-left: var(--space-2xs);
	}
	.draft-badge {
		display: inline-block;
		font-size: 0.7rem;
		padding: 0.1em 0.4em;
		margin-left: var(--space-2xs);
		border: 1px solid var(--accent);
		color: var(--accent);
		border-radius: var(--radius-s);
	}
	h1 {
		margin: 0 0 var(--space-m);
		font-size: var(--step-4);
		letter-spacing: -0.02em;
	}
	.lede {
		font-size: var(--step-1);
		color: var(--muted);
		line-height: 1.5;
		margin: 0 0 var(--space-l);
	}

	.provenance {
		border: 1px solid var(--rule);
		border-left: 3px solid var(--accent);
		border-radius: var(--radius-s);
		padding: var(--space-s) var(--space-m);
		margin: 0 0 var(--space-xl);
		background: var(--bg-subtle, transparent);
	}
	.provenance p {
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.55;
		color: var(--muted);
	}
	.provenance strong {
		color: var(--fg);
	}
	.provenance dl {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs) var(--space-m);
		margin: var(--space-xs) 0 0;
		font-family: var(--font-mono);
		font-size: 0.76rem;
	}
	.provenance dl > div {
		display: flex;
		gap: var(--space-3xs);
	}
	.provenance dt {
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	.provenance dt::after {
		content: ':';
	}
	.provenance dd {
		margin: 0;
		color: var(--fg);
	}

	.prose :global(p) {
		margin-bottom: var(--space-m);
	}
	.prose :global(h2),
	.prose :global(h3) {
		margin-top: var(--space-xl);
	}
	.prose :global(img) {
		display: block;
		margin: var(--space-l) auto;
		border-radius: var(--radius-m);
	}
	.post-footer {
		margin-top: var(--space-2xl);
		padding-top: var(--space-m);
		border-top: 1px solid var(--rule);
	}
	.tags {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2xs);
	}
	.tags > li {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--muted);
	}
</style>
