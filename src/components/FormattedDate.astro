---
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString('en-us', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
			// pubDate is date-only, so it parses as UTC midnight. Without this,
			// every reader west of Greenwich sees each post dated a day early.
			timeZone: 'UTC',
		})
	}
</time>
