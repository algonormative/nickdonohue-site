---
const today = new Date();
---

<footer>
	<div class="inner">
		<div class="links">
			<a href="https://github.com/algonormative" target="_blank" rel="me noopener">GitHub</a>
			<span class="sep">·</span>
			<a href="https://www.linkedin.com/in/ndonohue" target="_blank" rel="me noopener">LinkedIn</a>
			<span class="sep">·</span>
			<a href="https://lemon-agent.dev" target="_blank" rel="noopener">Lemon Agent</a>
			<span class="sep">·</span>
			<a href="https://lemon.audio" target="_blank" rel="noopener">LEMON AUDIO</a>
			<span class="sep">·</span>
			<a href="/rss.xml">RSS</a>
		</div>
		<div class="copy">&copy; {today.getFullYear()} Nick Donohue</div>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid var(--rule);
		margin-top: var(--space-2xl);
		padding: var(--space-l) var(--space-s);
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}
	.inner {
		max-width: var(--measure);
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-m);
		flex-wrap: wrap;
	}
	.links {
		display: flex;
		gap: var(--space-2xs);
		align-items: center;
	}
	.links a {
		color: var(--muted);
	}
	.links a:hover {
		color: var(--accent);
	}
	.sep {
		opacity: 0.5;
	}
	.copy {
		opacity: 0.85;
	}
	@media (max-width: 540px) {
		.inner {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
